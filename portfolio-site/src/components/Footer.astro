---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-content">
    <p>&copy; {currentYear} Portfolio. Built with Astro & AWS.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    background-color: #000000;
    border-top: var(--border-thick);
  }

  .footer-content {
    padding: var(--spacing-lg) var(--spacing-md);
    text-align: center;
    color: #FFFFFF;
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>
